# ─────────────────────────────────────────────────────────────
#  YouTube Live AI 리액션 설정 파일
#  cp .env.example .env  후 값을 채우세요. (.env 는 git 에 올리지 마세요)
#  main.py 가 pydantic-settings 로 읽고 타입/범위를 검증합니다.
# ─────────────────────────────────────────────────────────────

# ===== API 키 =====
# https://console.groq.com/keys   (STT 1순위)
GROQ_API_KEY=
# https://console.deepgram.com     (STT 폴백, 선택)
DEEPGRAM_API_KEY=
# https://console.anthropic.com    (리액션 생성)
ANTHROPIC_API_KEY=

# ===== STT (Phase 1) =====
# groq | deepgram  (나머지는 자동 폴백)
STT_PROVIDER=groq
# auto 면 자동 감지
STT_LANGUAGE=ko
# 더 빠르게: whisper-large-v3-turbo
GROQ_MODEL=whisper-large-v3
DEEPGRAM_MODEL=nova-2
# 3~5
CHUNK_SECONDS=4
STT_CONCURRENCY=2
STT_TIMEOUT=20
# 실패한 STT 공급자를 건너뛰는 시간(초)
STT_COOLDOWN=30
# 이보다 밀린 오디오 청크는 버림
MAX_LAG_SECONDS=15
# 이보다 조용하면 STT 생략
SILENCE_DBFS=-50
YTDLP_FORMAT=bestaudio/93/best
# 봇 확인 오류 시 cookies.txt 경로
YTDLP_COOKIES=

# ===== 리액션 생성 (Phase 2) =====
# false 면 자막만
REACTIONS=true
REACTION_MODEL=claude-haiku-5-5
# low | medium | high
REACTION_EFFORT=low
REACTION_TIMEOUT=10
# 맥락으로 기억할 최근 발언 수
REACTION_MEMORY_SIZE=10
# 높일수록 덜 자주 반응
REACTION_THRESHOLD=2.0
# 리액션 간 최소 간격(방송 시간 초). 강한 감정은 절반
REACTION_COOLDOWN=12
# 시청자에게 던진 질문
REACTION_QUESTION_COOLDOWN=3
# 생성이 이보다 늦으면 폐기
REACTION_MAX_AGE=8

# ===== 스트리머 맞춤 페르소나 =====
# 비워 두면 기본 시청자 말투. 값에 공백이 있으면 따옴표로 감싸세요.
# 예: "철수님"  (비우면 호칭을 쓰지 않음)
PERSONA_STREAMER_NAME=""
# 예: "소울라이크 게임 공략 방송, 차분한 분위기"
PERSONA_CHANNEL_TOPIC=""
# 예: "이 게임 오래 한 고인물, 가벼운 드립 좋아함"
PERSONA_VIEWER_STYLE=""
# 예: "스포일러 금지, 다른 스트리머 언급 금지"
PERSONA_EXTRA=""

# ===== 채팅 전송 (Phase 3) =====
# off | console(dry-run, 전송 안 함) | youtube-api(실전송)
CHAT_SENDER=console
# 모든 메시지 앞 AI 표기 (비워 둘 수 없음)
CHAT_LABEL="🤖AI: "
# 전송 간 랜덤 간격 하한(초, 30 이상)
CHAT_COOLDOWN_MIN=45
# 전송 간 랜덤 간격 상한(초)
CHAT_COOLDOWN_MAX=90
# 실행 1회(방송)당 최대 전송
CHAT_MAX_PER_STREAM=20
# 하루 최대 전송 (재시작해도 유지)
CHAT_MAX_PER_DAY=60
CHAT_STATE_FILE=.chat_state.json
# --input 테스트 시 전송 대상 영상 ID (보통 비움)
CHAT_VIDEO_ID=
YT_CLIENT_SECRET=client_secret.json
# `python chat_sender.py auth` 가 생성
YT_TOKEN_FILE=token.json
